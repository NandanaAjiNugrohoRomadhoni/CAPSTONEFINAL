#--------------------------------------------------------------------
# Docker production environment — override in CI for secrets
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

app.baseURL = 'http://localhost:4000/'

database.default.hostname = db
database.default.database = capstone
database.default.username = capstone
database.default.password = capstone_secret
database.default.DBDriver = MySQLi
database.default.port = 3306

