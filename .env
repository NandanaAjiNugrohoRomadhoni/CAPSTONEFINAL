# ═══════════════════════════════════════════════════════════
# .env — SATU-SATUNYA tempat ubah konfigurasi Docker
# ═══════════════════════════════════════════════════════════

# ── PORT (ganti kalau bentrok) ──────────────────────────
APP_PORT=4400
DB_PORT=4306
ADMINER_PORT=9000

# ── APP ─────────────────────────────────────────────────
APP_INTERNAL_PORT=4000
APP_BASE_URL=http://localhost:4400/

# ── KONEKSI DATABASE (dipakai app) ──────────────────────
# DB_HOST=db          → pakai DB lokal (container)
# DB_HOST=192.168.x.x → pakai DB remote / eksternal
DB_HOST=db
DB_INTERNAL_PORT=3306
DB_NAME=capstone
DB_USER=capstone
DB_PASS=capstone_secret
DB_DRIVER=MySQLi

# ── DB LOKAL (cuma kepakai waktu --profile local) ───────
DB_ROOT_PASS=root_secret
DB_IMAGE=docker.io/library/mariadb:11

# ── ADMINER ─────────────────────────────────────────────
ADMINER_INTERNAL_PORT=8080
