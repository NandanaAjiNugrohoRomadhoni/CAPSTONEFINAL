:4000 {
    root * /app/public

    encode gzip zstd br

    # 1. Hashed Next.js chunks — safe to cache forever
    @nextStatic path /_next/static/*
    header @nextStatic Cache-Control "public, max-age=31536000, immutable"

    # 2. Other public static assets
    @assets {
        path_regexp assets \.(ico|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|eot)$
        not path /_next/static/*
    }

    # 3. HTML must NEVER be immutable — new deploys must propagate
    @html path_regexp html \.(html)$
    header @html Cache-Control "no-cache, must-revalidate"

    # 4. Serve /_next/* directly — no need to hit PHP at all
    handle /_next/* {
        file_server
    }

    # 5. Everything else — PHP (CI4 + SPA fallback)
    handle {
        php_server {
            # Try real file first (images, etc.), then always fall to index.php
            try_files {path} index.php
        }
    }
}
